SECRET_KEY=django-insecure-change-me-in-production

DEBUG=True

# Database — defaults to SQLite for quick local dev.
# Switch to PostgreSQL for production.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# PostgreSQL example:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=stageos
# DB_USER=postgres
# DB_PASSWORD=secret
# DB_HOST=localhost
# DB_PORT=5432

# Email (leave as console for local dev — outputs to terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=StageOS <noreply@stageos.co.za>
FRONTEND_BASE_URL=http://localhost:3000
